        {
          "name": "200 Update an existing pet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('\"content-type\" response header is \"application/json\"', () => {",
                  "    pm.expect(pm.response.headers.get('content-type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Response body name is \"Sharik\"', () => {",
                  "    pm.expect(pm.response.json().name).to.eql('Sharik');",
                  "});",
                  "",
                  "pm.test('Photo URL is \"stepik.org\"', () => {",
                  "    pm.expect(pm.response.json().photoUrls[0]).to.eql('stepik.org');",
                  "});",
                  "",
                  "pm.test('Has an item in URL array with value stepik.org', () => {",
                  "    pm.expect(pm.response.json().photoUrls).to.include('stepik.org');",
                  "    });",
                  "",
                  "pm.test('Array item has \"stepik.org\" in it', () => {",
                  "    const array = pm.response.json().photoUrls;",
                  "    for (let item of array) {",
                  "        pm.expect(item).to.equal('stepik.org');",
                  "    }",
                  "});"
                ],
