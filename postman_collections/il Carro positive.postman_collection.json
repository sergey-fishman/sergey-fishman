                  "const pad = (n) => String(n).padStart(2, '0');\r",
                  "const formatDate = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\r",
                  "\r",
                  "pm.request.body.update({\r",
                  "    mode: 'raw',\r",
                  "    raw: JSON.stringify({\r",
                  "        city: \"Rishon LeZion\",\r",
                  "        startDate: formatDate(today),\r",
                  "        endDate: formatDate(endDate)\r",
                  "    }, null, 2),\r",
                  "    options: { raw: { language: 'json' } }\r",
                  "});"
                ],
