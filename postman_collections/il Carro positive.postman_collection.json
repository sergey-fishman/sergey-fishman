              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\r",
                  "pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);\r",
                  "\r",
                  "pm.test(\"Check if accessToken is set\", function () {\r",
                  "    pm.expect(jsonData.accessToken).to.not.be.undefined;\r",
                  "});\r",
                  "\r",
                  "const requestBody = JSON.parse(pm.request.body.raw);\r",
                  "const savedUsername = requestBody.username;\r",
                  "pm.collectionVariables.set(\"savedUsername\", savedUsername);\r",
                  "\r",
                  "pm.test(\"JWT has valid three-part format\", () => {\r",
                  "    const tokenParts = jsonData.accessToken.split('.');\r",
                  "    pm.expect(tokenParts).to.have.lengthOf(3);\r",
                  "    pm.expect(tokenParts[0]).to.not.be.empty;\r",
                  "    pm.expect(tokenParts[1]).to.not.be.empty;\r",
                  "    pm.expect(tokenParts[2]).to.not.be.empty;\r",
                  "});"
